{
  "name": "lab-management-system",
  "version": "1.0.0",
  "description": "LAN-based laboratory management system: test catalog, quotations and billing",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:client": "vite --config client/vite.config.mts",
    "build": "tsc -p client && vite build --config client/vite.config.mts",
    "lint": "eslint client/src",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "hash-password": "node scripts/generate-password-hash.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report e2e/report"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.18.0"
  },
  "devDependencies": {
    "@ant-design/icons": "6.3.4",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "antd": "6.6.6",
    "dayjs": "1.11.23",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "jsbarcode": "3.12.3",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "prisma": "^5.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
