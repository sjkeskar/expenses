# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://ptsuser:changeme@localhost:5432/payment_tracking"

# Port the Express server listens on (locked in as 8080)
PORT=8080

# Secret used to sign the session cookie. Use a long random string in production.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-this-with-a-long-random-string"

# Session lifetime in milliseconds. 4 hours = 14400000
SESSION_MAX_AGE_MS=14400000
